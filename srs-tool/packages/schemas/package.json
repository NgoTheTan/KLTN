{
  "name": "@srs-tool/schemas",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Zod schemas for API, forms, and LLM structured outputs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
