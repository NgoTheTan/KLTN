{
  "name": "@srs-tool/pipeline",
  "version": "0.1.0",
  "private": true,
  "description": "8-stage requirement processing pipeline with three-tier decision router",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
